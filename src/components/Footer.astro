---
import ContactCard from "./ContactCard.astro";
import { isCurrentPath, nav, site } from "../data/site";

const pathname = Astro.url.pathname;
const year = new Date().getFullYear();
---

<footer class="on-dark mt-auto bg-bark text-cream">
  <div class="mx-auto grid max-w-5xl gap-12 px-6 py-14 md:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] md:items-start">
    <div>
      <p class="font-serif text-2xl leading-tight">{site.name}</p>
      <p class="mt-3 max-w-sm text-cream/85">{site.positioning}</p>
      <nav class="mt-8" aria-label="Footer">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            nav.map((item) => {
              const current = isCurrentPath(pathname, item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={current ? "page" : undefined}
                    class:list={[
                      "inline-flex min-h-11 items-center text-sm font-semibold underline decoration-cream/40 underline-offset-4 hover:decoration-cream",
                      current && "decoration-cream",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-brass">Contact</h2>
      <div class="mt-4">
        <ContactCard tone="plain" heading="p" idPrefix="footer-" />
      </div>
    </div>
  </div>
  <div class="border-t border-cream/15">
    <p class="mx-auto max-w-5xl px-6 py-4 text-sm text-cream/75">
      © {year} {site.name}
    </p>
  </div>
</footer>
