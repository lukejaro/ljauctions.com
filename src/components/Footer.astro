---
import ContactCard from "./ContactCard.astro";
import { isCurrentPath, nav, site, texasAuctioneerLicenseLine } from "../data/site";

const pathname = Astro.url.pathname;
const year = new Date().getFullYear();
const licenseLine = texasAuctioneerLicenseLine();
const slim = pathname === "/contact" || pathname === "/contact/";
---

<footer class:list={["on-dark mt-auto bg-bark text-cream", slim && "footer-slim"]} transition:name="site-footer" transition:animate="none">
  {
    slim ? (
      <div class="wrap footer-slim-row">
        <p class="font-serif text-xl leading-tight">{site.name}</p>
        <p class="text-sm text-cream/75">
          © {year} {site.name}
          {licenseLine && <span> · {licenseLine}</span>}
        </p>
      </div>
    ) : (
      <>
        <div class="footer-grid wrap">
          <div class="footer-copy">
            <p class="eyebrow text-brass">Benefit auctions</p>
            <p class="mt-4 font-serif text-3xl leading-tight">{site.name}</p>
            <p class="mt-4 max-w-sm text-lg text-cream/85">{site.positioning}</p>
          </div>
          <nav aria-label="Footer">
            <ul class="footer-nav">
              {
                nav.map((item) => {
                  const current = isCurrentPath(pathname, item.href);
                  return (
                    <li>
                      <a
                        href={item.href}
                        aria-current={current ? "page" : undefined}
                        class="footer-nav-link"
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>
          <div class="footer-card">
            <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-brass">Contact</h2>
            <div class="mt-4">
              <ContactCard tone="plain" heading="p" idPrefix="footer-" omitName={true} />
            </div>
          </div>
        </div>
        <div class="border-t border-cream/15">
          <p class="wrap flex flex-col gap-1 py-5 text-sm text-cream/75 sm:flex-row sm:items-baseline sm:justify-between">
            <span>© {year} {site.name}</span>
            {licenseLine && <span>{licenseLine}</span>}
          </p>
        </div>
      </>
    )
  }
</footer>
