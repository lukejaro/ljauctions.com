---
import { formatAuctionDate, type Auction } from "../data/site";

interface Props {
  auctions: Auction[];
  emptyTitle: string;
  emptyText: string;
  headingLevel?: "h2" | "h3";
  titleLevel?: "h2" | "h3";
}

const { auctions, emptyTitle, emptyText, headingLevel = "h2", titleLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const Title = titleLevel;
---

{
  auctions.length === 0 ? (
    <div class="wipe panel px-6 py-14 text-center md:px-10">
      <Heading class="font-serif text-3xl text-ink md:text-4xl">{emptyTitle}</Heading>
      <p class="mx-auto mt-4 max-w-md text-pretty text-lg text-ink-soft">{emptyText}</p>
      <a href="/contact" class="btn btn-primary mt-8">Check your date</a>
    </div>
  ) : (
    <ol class="divide-y divide-line border-y border-line">
      {auctions.map((auction) => (
        <li>
          <article class="reveal grid gap-2 py-8 md:grid-cols-[16rem_1fr] md:gap-10">
            <p class="text-sm font-semibold text-forest">
              <time datetime={auction.date}>{formatAuctionDate(auction.date)}</time>
              {auction.time ? <span class="mt-1 block font-normal text-ink-soft">{auction.time}</span> : null}
            </p>
            <div>
              <Title class="font-serif text-2xl leading-tight text-ink">{auction.title}</Title>
              <p class="mt-2 text-ink">{auction.location}</p>
              <p class="mt-2 max-w-xl text-pretty text-ink-soft">{auction.summary}</p>
            </div>
          </article>
        </li>
      ))}
    </ol>
  )
}
