---
import { contact, contactFields, emailMailto, texasAuctioneerLicenseLine, vcardFile } from "../data/site";

interface Props {
  tone?: "card" | "plain";
  heading?: "h2" | "p";
  /** Prefix field ids when more than one card is on the page. */
  idPrefix?: string;
  /** Footer already shows the name in the card heading. */
  omitName?: boolean;
}

const { tone = "card", heading = "p", idPrefix = "", omitName = false } = Astro.props;
const fields = contactFields().filter(
  (field) => !field.placeholder && !(omitName && field.id === "name"),
);
const mailto = emailMailto();
const licenseLine = texasAuctioneerLicenseLine();
const Heading = heading;
const isCard = tone === "card";
---

<address
  class:list={[
    "not-italic",
    isCard
      ? "border border-line bg-paper px-6 py-9 shadow-[0_18px_40px_rgba(42,30,22,0.06)] sm:px-10 sm:py-11"
      : "on-dark text-cream",
  ]}
>
  <div class="flex items-center gap-4">
    <span
      class:list={[
        "mark",
        !isCard && "mark-light",
      ]}
      aria-hidden="true"
    >
      LJ
    </span>
    <div>
      <Heading class:list={["font-serif text-2xl leading-tight", isCard ? "text-ink" : "text-cream"]}>
        {contact.contactName}
      </Heading>
      <p class:list={["text-sm", isCard ? "text-ink-soft" : "text-cream/80"]}>
        {contact.role}, {contact.businessName}
      </p>
      {
        licenseLine && (
          <p class:list={["mt-2 text-sm", isCard ? "text-ink-soft" : "text-cream/75"]}>{licenseLine}</p>
        )
      }
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row">
    <a
      href={vcardFile.href}
      download={vcardFile.filename}
      type="text/vcard"
      class:list={[
        "btn w-full sm:w-auto",
        isCard ? "btn-primary" : "btn-cream",
      ]}
    >
      Add to contacts
    </a>
    <a
      href={mailto}
      class:list={[
        "btn w-full sm:w-auto",
        isCard ? "btn-line-ink" : "btn-line",
      ]}
    >
      Email us
    </a>
  </div>

  <dl class:list={["mt-6", isCard ? "divide-y divide-line" : "divide-y divide-cream/20"]}>
    {
      fields.map((field) => (
        <div class="grid gap-1 py-3 sm:grid-cols-[8.5rem_1fr] sm:items-baseline sm:gap-4">
          <dt
            class:list={[
              "text-xs font-semibold uppercase tracking-[0.14em]",
              isCard ? "text-wood" : "text-brass",
            ]}
          >
            {field.label}
          </dt>
          <dd id={`${idPrefix}${field.id}`} class:list={["text-base", isCard ? "text-ink" : "text-cream"]}>
            {field.href ? (
              <a
                href={field.href}
                class:list={[
                  "inline-flex min-h-11 items-center underline decoration-1 underline-offset-4",
                  isCard ? "hover:text-forest" : "hover:text-brass",
                ]}
              >
                {field.text}
              </a>
            ) : (
              <span class="whitespace-pre-line">{field.text}</span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</address>
