---
import type { GalleryShot } from "../data/photos";
import Shot from "./Shot.astro";

interface Props {
  shots: GalleryShot[];
  labelledBy: string;
}

const { shots, labelledBy } = Astro.props;
const sizes =
  shots.length === 3
    ? "(min-width: 768px) min(28vw, 420px), min(92vw, 420px)"
    : "(min-width: 900px) 40vw, (min-width: 768px) 46vw, 92vw";
---

<ul
  class:list={[
    "photo-grid",
    shots.length === 2 && "photo-grid-2",
    shots.length === 3 && "photo-grid-3",
  ]}
  aria-labelledby={labelledBy}
>
  {
    shots.map((shot) => (
      <li class="shot-frame">
        <Shot
          src={shot.src}
          alt={shot.alt}
          widths={shot.widths}
          sizes={sizes}
          position={shot.position}
        />
      </li>
    ))
  }
</ul>
