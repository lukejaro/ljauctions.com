---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="page-intro border-b border-line bg-cream-deep">
  <div class="intro-copy mx-auto max-w-5xl px-6 py-14 md:py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-forest">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl font-serif text-4xl leading-tight text-ink md:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg text-pretty text-ink-soft">{lede}</p>
  </div>
</header>
