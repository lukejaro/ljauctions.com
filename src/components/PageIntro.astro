---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="page-intro border-b border-line bg-paper">
  <div class="intro-copy wrap py-16 md:py-24">
    <p class="eyebrow text-wood">{eyebrow}</p>
    <h1 class="display mt-4 max-w-4xl text-ink">{title}</h1>
    <p class="measure mt-5 text-lg text-pretty leading-relaxed text-ink-soft md:text-xl">{lede}</p>
    <slot />
  </div>
</header>
