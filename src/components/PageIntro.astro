---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="page-intro bg-paper">
  <div class="intro-copy wrap py-14 md:py-20">
    <p class="eyebrow text-forest">{eyebrow}</p>
    <h1 class="page-title mt-4 max-w-4xl text-ink">{title}</h1>
    <p class="page-lede measure mt-5 text-pretty text-ink-soft">{lede}</p>
    <slot />
  </div>
</header>
