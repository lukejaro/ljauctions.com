---
import club from "../assets/logos/org-100-club-sa.png";
import kids from "../assets/logos/org-kids-feeding-kids.png";
import { workedWith } from "../data/site";
import type { ImageMetadata } from "astro";

const logos: Record<string, ImageMetadata> = {
  "100 Club of San Antonio": club,
  "Kids Feeding Kids": kids,
};
---

<section class="border-b border-line bg-cream" aria-labelledby="worked-with">
  <div class="mx-auto max-w-5xl px-6 py-12 md:py-16">
    <h2 id="worked-with" class="reveal font-serif text-3xl text-ink md:text-4xl">
      Organizations I've Worked With
    </h2>
    <ul class="org-logos mt-8">
      {
        workedWith.map((name) => {
          const logo = logos[name];
          return (
            <li class="org-logo" tabindex="0">
              {logo ? (
                <img
                  src={logo.src}
                  alt={name}
                  width={logo.width}
                  height={logo.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <p class="org-wordmark">{name}</p>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
