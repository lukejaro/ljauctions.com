---
import club from "../assets/logos/org-100-club-sa.png";
import kids from "../assets/logos/org-kids-feeding-kids.png";
import { workedWith } from "../data/site";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

const logos: Record<string, ImageMetadata> = {
  "100 Club of San Antonio": club,
  "Kids Feeding Kids": kids,
};

// Logos display at roughly 160-240px wide; serve a 480px WebP (2x) instead of the full-size PNG.
const optimized = Object.fromEntries(
  await Promise.all(
    Object.entries(logos).map(async ([name, img]) => [name, await getImage({ src: img, width: 480, format: "webp" })]),
  ),
);
---

<section class="border-y border-line bg-paper" aria-labelledby="worked-with">
  <div class="wrap py-14 md:py-20">
    <h2 id="worked-with" class="reveal font-serif text-3xl text-ink md:text-4xl">Nonprofits I've worked with.</h2>
    <ul class="org-logos">
      {
        workedWith.map((name) => {
          const logo = logos[name];
          const small = optimized[name];
          return (
            <li class="org-logo" tabindex="0">
              {logo ? (
                <img
                  src={small.src}
                  alt={name}
                  width={logo.width}
                  height={logo.height}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <p class="org-wordmark">{name}</p>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
