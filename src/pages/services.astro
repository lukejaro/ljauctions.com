---
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqs, services } from "../data/site";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="Services"
  description="LJ Auctions calls benefit and charity auctions, estates, and equipment. Texas Auctioneer License #18590."
  extraStructuredData={faqSchema}
>
  <PageIntro
    eyebrow="Services"
    title="Benefit auctions, estates, and equipment."
    lede="Live bid calling for charity and nonprofit sales, then estates, equipment, and business dispersals."
  />

  <section aria-labelledby="offerings">
    <h2 id="offerings" class="sr-only">Offerings</h2>
    <ol class="service-list">
      {
        services.map((service, index) => {
          const feature = index === 0;
          return (
            <li id={feature ? "benefit" : undefined} class:list={["service-row", feature && "service-row-feature"]}>
              <div class="service-row-inner">
                <div>
                  {feature && <p class="service-kicker">PRIMARY</p>}
                  <h3 class="font-serif leading-tight">{service.title}</h3>
                </div>
                <p class="service-desc">{service.text}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
    <p class="wrap service-cta">
      <a href="/contact" class="btn btn-primary">Check your date</a>
    </p>
  </section>

  <section class="bg-cream-deep" aria-labelledby="faq">
    <div class="faq-layout wrap py-14 md:py-20">
      <div class="faq-intro">
        <p class="eyebrow text-forest">Questions</p>
        <h2 id="faq" class="mt-3 font-serif text-3xl text-ink md:text-4xl">Before you book</h2>
      </div>
      <div class="faq-list">
        {
          faqs.map((item, index) => (
            <details class="faq-item" open={index === 0}>
              <summary class="faq-summary">{item.question}</summary>
              <p class="faq-answer">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
