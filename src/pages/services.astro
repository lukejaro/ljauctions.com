---
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqs, services } from "../data/site";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="Services"
  description="LJ Auctions calls benefit and charity auctions, estates, and equipment. Texas Auctioneer License #18590."
  extraStructuredData={faqSchema}
>
  <PageIntro
    eyebrow="Services"
    title="What LJ Auctions sells and calls."
    lede="Live auctioneering, and the preparation that makes a sale bill worth reading."
  />

  <section class="mx-auto max-w-5xl px-6 py-16" aria-labelledby="offerings">
    <h2 id="offerings" class="sr-only">Offerings</h2>
    <ol class="reveal-group divide-y divide-line border-y border-line">
      {
        services.map((service) => (
          <li class="grid gap-3 py-8 md:grid-cols-[16rem_1fr] md:gap-10">
            <h3 class="font-serif text-2xl leading-tight text-ink">{service.title}</h3>
            <p class="max-w-xl text-pretty text-ink-soft">{service.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8">
      <a
        href="/contact"
        class="inline-flex min-h-11 items-center justify-center bg-forest px-5 text-sm font-semibold text-cream hover:bg-forest-deep"
      >
        Check your date
      </a>
    </p>
  </section>

  <section class="border-t border-line bg-cream-deep" aria-labelledby="faq">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 id="faq" class="reveal font-serif text-3xl text-ink">Questions</h2>
      <dl class="mt-8 max-w-3xl divide-y divide-line border-y border-line">
        {
          faqs.map((item) => (
            <div class="reveal py-6">
              <dt class="font-serif text-xl text-ink">{item.question}</dt>
              <dd class="mt-3 text-pretty text-ink-soft">{item.answer}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>
