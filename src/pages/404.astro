---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page is not on the LJ Auctions site.">
  <section class="page-intro wrap py-20 md:py-28">
    <div class="intro-copy">
      <p class="eyebrow text-forest">404</p>
      <h1 class="display mt-5 text-ink">Page not found</h1>
      <p class="measure mt-5 text-lg text-ink-soft">That address is not on ljauctions.com.</p>
      <p class="mt-8">
        <a href="/" class="btn btn-primary">Back to home</a>
      </p>
    </div>
  </section>
</BaseLayout>
