---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page is not on the LJ Auctions site.">
  <section class="page-intro mx-auto max-w-5xl px-6 py-20">
    <div class="intro-copy">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-forest">404</p>
    <h1 class="mt-3 font-serif text-4xl text-ink md:text-5xl">Page not found</h1>
    <p class="mt-4 max-w-xl text-lg text-ink-soft">That address is not on ljauctions.com.</p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-flex min-h-11 items-center justify-center bg-forest px-5 text-sm font-semibold text-cream hover:bg-forest-deep"
      >
        Back to home
      </a>
    </p>
    </div>
  </section>
</BaseLayout>
