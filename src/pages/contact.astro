---
import ContactCard from "../components/ContactCard.astro";
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Contact Luke Jaroszewski, auctioneer for LJ Auctions. Call (830) 743-1180 or email luke.jaroszewski@gmail.com."
>
  <PageIntro
    eyebrow="Contact"
    title="Reach Luke Jaroszewski"
    lede="Add the contact to your phone, or call and email from the card. Service area and address are still to be confirmed."
  />

  <section class="mx-auto max-w-xl px-6 py-16" aria-labelledby="contact-card-heading">
    <h2 id="contact-card-heading" class="sr-only">Business contact card</h2>
    <ContactCard />
  </section>
</BaseLayout>
