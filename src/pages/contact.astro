---
import ContactCard from "../components/ContactCard.astro";
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Contact Luke Jaroszewski, auctioneer for LJ Auctions. Call (830) 743-1180 or email luke.jaroszewski@gmail.com."
>
  <PageIntro
    eyebrow="Contact"
    title="Check your date."
    lede="For a benefit auction first, or for an estate or equipment sale. Call, email, or add Luke Jaroszewski to your phone."
  />

  <section class="reveal mx-auto w-full max-w-2xl px-6 py-16 md:py-24" aria-labelledby="contact-card-heading">
    <h2 id="contact-card-heading" class="sr-only">Business contact card</h2>
    <ContactCard />
  </section>
</BaseLayout>
