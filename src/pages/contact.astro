---
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { calendlyUrl, contact, emailMailto, faqs, texasAuctioneerLicenseLine, vcardFile } from "../data/site";

const licenseLine = texasAuctioneerLicenseLine();
const dateAnswer = faqs[1].answer;
---

<BaseLayout
  title="Contact"
  seoTitle="Book a Benefit Auctioneer in Texas | LJ Auctions"
  description="Check your fundraiser date with Luke Jaroszewski, benefit auctioneer for San Antonio, Seguin and Central Texas. Call (830) 743-1180."
  breadcrumb="Contact"
>
  <PageIntro
    eyebrow="Contact"
    title="Check your date."
    lede="For a benefit auction first, or for an estate or equipment sale. Call, email, or add Luke Jaroszewski to your phone."
  />

  <section class="bg-cream" aria-labelledby="what-to-send">
    <div class="contact-split wrap py-14 md:py-20">
      <div class="contact-actions">
        <a class="contact-action contact-action-fill" href={`tel:${contact.phoneTel}`}>
          Call {contact.phoneDisplay}
        </a>
        <a class="contact-action contact-action-line" href={emailMailto()}>Email</a>
        <a
          class="contact-action contact-action-line"
          href={vcardFile.href}
          download={vcardFile.filename}
          type="text/vcard"
        >
          Add to contacts
        </a>
        <a
          class="contact-action contact-action-line"
          href={calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a call
        </a>
      </div>
      <aside class="contact-panel">
        <h2 id="what-to-send" class="font-serif text-2xl text-ink">What to send</h2>
        <p class="mt-4 text-pretty text-ink">{dateAnswer}</p>
        {licenseLine && <p class="mt-4 text-sm font-semibold tracking-wide text-ink">{licenseLine}</p>}
        {
          contact.serviceArea && (
            <dl class="contact-fields mt-6 border-t border-line">
              <div class="contact-field grid gap-1 py-3 sm:grid-cols-[8.5rem_1fr] sm:items-baseline sm:gap-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-wood">Service area</dt>
                <dd id="contact-service-area" class="text-base text-ink">{contact.serviceArea}</dd>
              </div>
            </dl>
          )
        }
      </aside>
    </div>
  </section>
</BaseLayout>
