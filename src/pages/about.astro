---
import BookingBand from "../components/BookingBand.astro";
import OrgLogos from "../components/OrgLogos.astro";
import PageIntro from "../components/PageIntro.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import Shot from "../components/Shot.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutShots, portraitPhoto } from "../data/photos";
import { approach, credentialTodos, story, texasAuctioneerLicenseLine } from "../data/site";

const confirmedCredentials = credentialTodos.filter((item) => item.value?.trim());
---

<BaseLayout
  title="About"
  description="Luke Jaroszewski calls benefit and charity auctions. He started auctioneering at 18 and has called hundreds of auctions for nonprofits. Texas Auctioneer License #18590."
>
  <PageIntro
    eyebrow="Benefit auctions"
    title="I call benefit auctions."
    lede="I started auctioneering at 18. I have called hundreds of auctions for nonprofits, and I have helped at auctions that grossed over $3 million in sales. Estates and equipment are part of the work, too."
  />

  <section class="bg-cream" aria-labelledby="my-story">
    <div class="wrap py-14 md:py-20">
    <div class="grid items-start gap-10 md:grid-cols-[minmax(14rem,18rem)_minmax(0,1fr)]">
      <figure class="shot-frame portrait-frame mx-auto w-full max-w-xs">
        <Shot
          src={portraitPhoto.src}
          alt={portraitPhoto.alt}
          widths={[...portraitPhoto.widths]}
          sizes="(min-width: 768px) 18rem, min(20rem, calc(100vw - 3rem))"
          position={portraitPhoto.position}
        />
      </figure>
      <div>
        <p class="reveal eyebrow text-forest">My story</p>
        <h2 id="my-story" class="reveal display-sm mt-4 text-ink">{story.heading}</h2>
        <div class="mt-6 max-w-2xl space-y-4 text-lg text-pretty leading-relaxed text-ink">
          {story.paragraphs.map((paragraph) => <p class="reveal">{paragraph}</p>)}
        </div>
        {
          texasAuctioneerLicenseLine() && (
            <p class="reveal mt-6 text-sm font-semibold tracking-wide text-ink">{texasAuctioneerLicenseLine()}</p>
          )
        }
      </div>
    </div>
    </div>
  </section>

  <OrgLogos />

  <section class="bg-cream" aria-labelledby="photos">
    <div class="wrap py-14 md:py-20">
    <p class="reveal eyebrow text-forest">The call</p>
    <h2 id="photos" class="reveal display-sm mt-4 text-ink">At a sale</h2>
    <div class="mt-10">
      <PhotoGrid shots={aboutShots} labelledBy="photos" />
    </div>
    </div>
  </section>

  <section class="bg-cream-deep" aria-labelledby="approach">
    <div class="wrap py-14 md:py-20">
    <h2 id="approach" class="reveal display-sm text-ink">How a sale is run</h2>
    <ol class="reveal-group mt-10 grid gap-4 md:grid-cols-3">
      {
        approach.map((step, index) => (
          <li class="panel">
            <p class="font-serif text-3xl leading-none text-wood">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-4 font-serif text-2xl leading-tight text-ink">{step.title}</h3>
            <p class="mt-3 text-pretty leading-relaxed text-ink-soft">{step.text}</p>
          </li>
        ))
      }
    </ol>
    </div>
  </section>

  <section class="reveal on-dark bg-bark text-cream" aria-labelledby="credentials">
    <div class="wrap py-14 md:py-20">
      <h2 id="credentials" class="font-serif text-3xl">
        {confirmedCredentials.length > 0 ? "Biography and credentials" : "License"}
      </h2>
      {
        texasAuctioneerLicenseLine() && (
            <p class="mt-4 text-lg text-cream/90">{texasAuctioneerLicenseLine()}</p>
        )
      }
      {
        confirmedCredentials.length > 0 && (
          <ul class="mt-8 max-w-2xl divide-y divide-cream/20 border-y border-cream/20">
            {confirmedCredentials.map((item) => (
              <li class="grid gap-2 py-4 sm:grid-cols-[14rem_1fr] sm:items-baseline">
                <p class="text-sm font-semibold text-brass">{item.label}</p>
                <p class="text-cream">{item.value}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <BookingBand id="about-booking" />
</BaseLayout>
