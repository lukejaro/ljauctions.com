---
import OrgLogos from "../components/OrgLogos.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import Shot from "../components/Shot.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { heroPhoto, homeShots } from "../data/photos";
import {
  auctionCategories,
  bookingSteps,
  confirmedStats,
  contact,
  site,
  story,
  upcomingAuctions,
  upcomingFrom,
} from "../data/site";

const sales = upcomingFrom(upcomingAuctions);
const nextSale = sales.slice(0, 1);
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero on-dark bg-bark text-cream">
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="hero-split wrap">
      <div class="hero-copy">
        <p class="hero-item hero-kicker">LJ AUCTIONS · TEXAS AUCTIONEER #18590</p>
        <h1 class="hero-item hero-title">Benefit auctioneer for nonprofits.</h1>
        <p class="hero-item hero-sub">{site.positioning}</p>
        <div class="hero-item hero-actions">
          <a href="/contact" class="btn-check">Check your date</a>
          <a href={`tel:${contact.phoneTel}`} class="btn-call">Call {contact.phoneDisplay}</a>
        </div>
      </div>
      <figure class="hero-photo">
        <div class="shot-frame">
          <Shot
            src={heroPhoto.src}
            alt={heroPhoto.alt}
            widths={[...heroPhoto.widths]}
            sizes="(min-width: 900px) 440px, min(100vw, 28rem)"
            position={heroPhoto.position}
            eager={true}
          />
        </div>
      </figure>
    </div>
  </section>

  <section aria-label="Confirmed facts" class="stat-band">
    <dl class="stat-grid wrap">
      {
        confirmedStats.map((item) => (
          <div>
            <dd class="stat-value">{item.text}</dd>
            <dt class="stat-label">{item.label}</dt>
          </div>
        ))
      }
    </dl>
  </section>

  <OrgLogos />

  <section class="wrap py-16 md:py-20" aria-labelledby="story-teaser">
    <p class="reveal eyebrow text-wood">About</p>
    <h2 id="story-teaser" class="reveal mt-3 font-serif text-3xl text-ink md:text-4xl">{story.heading}</h2>
    <div class="reveal mt-6 max-w-2xl space-y-4 text-lg text-pretty text-ink">
      <p>{story.paragraphs[1]}</p>
      <p>{story.paragraphs[2]}</p>
      <p>{story.paragraphs[0]}</p>
    </div>
    <p class="reveal mt-6">
      <a href="/about#my-story" class="font-semibold text-forest underline decoration-1 underline-offset-4 hover:text-forest-deep">
        Read my story
      </a>
    </p>
  </section>

  <section class="work border-t border-line" aria-labelledby="what-we-auction">
    <div class="work-pin wrap py-14 md:py-16">
      <div class="work-intro">
        <p class="eyebrow text-wood">The work</p>
        <h2 id="what-we-auction" class="mt-3 font-serif text-3xl text-ink md:text-4xl">What we auction</h2>
      </div>
      <ol class="work-list">
        {
          auctionCategories.map((category, index) => (
            <li class:list={["work-card", `work-card-${index}`]}>
              <p class="work-num" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h3 class="mt-4 font-serif text-2xl leading-tight text-ink">{category.title}</h3>
              <p class="mt-3 text-pretty text-ink-soft">{category.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-t border-line bg-cream-deep" aria-labelledby="how-booking">
    <div class="wrap py-16 md:py-20">
      <p class="reveal eyebrow text-wood">Booking</p>
      <h2 id="how-booking" class="reveal mt-3 font-serif text-3xl text-ink md:text-4xl">How a date gets on the book</h2>
      <ol class="reveal-group mt-8 grid gap-4 md:grid-cols-3">
        {
          bookingSteps.map((step, index) => (
            <li class="work-card">
              <p class="work-num">{String(index + 1).padStart(2, "0")}</p>
              <h3 class="mt-4 font-serif text-xl leading-tight text-ink">{step.title}</h3>
              <p class="mt-3 text-pretty text-ink-soft">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="calling">
    <div class="wrap py-16 md:py-20">
      <p class="reveal eyebrow text-wood">The call</p>
      <h2 id="calling" class="reveal mt-3 font-serif text-3xl text-ink md:text-4xl">On the stand</h2>
      <div class="mt-8">
        <PhotoGrid shots={homeShots} labelledBy="calling" />
      </div>
    </div>
  </section>

  {
    sales.length === 0 ? (
      <section class="next-band border-t border-line" aria-labelledby="next-sale">
        <div class="wrap next-band-inner">
          <h2 id="next-sale" class="font-serif text-2xl text-ink">
            Now booking. Check your date.
          </h2>
          <a href="/contact" class="btn-check btn-check-ink">
            Check your date
          </a>
        </div>
      </section>
    ) : (
      <section class="border-t border-line" aria-labelledby="next-sale">
        <div class="wrap py-16">
          <h2 id="next-sale" class="font-serif text-3xl text-ink">
            Next sale
          </h2>
          <ol class="mt-6 divide-y divide-line border-y border-line">
            {nextSale.map((auction) => (
              <li class="py-6">
                <p class="font-semibold text-forest">{auction.date}</p>
                <p class="mt-1 font-serif text-2xl text-ink">{auction.title}</p>
                <p class="mt-1 text-ink-soft">{auction.location}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }
</BaseLayout>
